{
	"name": "KeePassHttp-Link",
	"version": "2.1.0",
	"manifest_version": 2,
	"description": "Fill KeePass logins in Firefox, through the KeePassHttp plugin on localhost.",
	"icons": {
		"48": "icons/icon.svg",
		"96": "icons/icon.svg",
		"128": "icons/icon.svg"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "keepasshttp-link@odyodyodys.github.io",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"browser_action": {
		"default_icon": "icons/toolbar-normal-light.svg",
		"theme_icons": [
			{ "light": "icons/toolbar-normal-dark.svg", "dark": "icons/toolbar-normal-light.svg", "size": 16 },
			{ "light": "icons/toolbar-normal-dark.svg", "dark": "icons/toolbar-normal-light.svg", "size": 32 }
		],
		"default_title": "KeePassHttp-Link",
		"default_popup": "popups/popup.html"
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"background": {
		"scripts": [
			"background/cryptoHelpers.js",
			"background/utils.js",
			"background/keepass.js",
			"background/httpauth.js",
			"background/icon.js",
			"background/browserAction.js",
			"background/page.js",
			"background/senderPolicy.js",
			"background/event.js",
			"background/init.js"
		]
	},
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"exclude_matches": [
				"*://*/*.xml",
				"*://*/*.xsd"
			],
			"js": [
				"kphc.js"
			],
			"run_at": "document_idle",
			"all_frames": true
		}
	],
	"commands": {
		"fill-username-password": {
			"description": "Insert username + password",
			"suggested_key": {
				"default": "Alt+Shift+U",
				"mac": "Alt+Shift+U"
			}
		},
		"fill-password": {
			"description": "Insert a password",
			"suggested_key": {
				"default": "Alt+Shift+P",
				"mac": "Alt+Shift+P"
			}
		}
	},
	"permissions": [
		"contextMenus",
		"clipboardWrite",
		"storage",
		"webRequest",
		"webRequestBlocking",
		"https://*/*",
		"http://*/*"
	]
}